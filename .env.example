# Excalidraw Self-Hosted Configuration

# Database - using existing PostgreSQL 16 in podman
# Container: postgres16, Port: 54316, role/database: excalidraw
DATABASE_URL=postgresql://excalidraw:CHANGE_ME@localhost:54316/excalidraw
# Same database, reached from inside the api container (docker-compose)
DATABASE_URL_DOCKER=postgresql://excalidraw:CHANGE_ME@host.docker.internal:54316/excalidraw

# API
JWT_SECRET=CHANGE_ME_generate_with__openssl_rand_-hex_32
UPLOAD_DIR=/uploads
PORT=4001

# Frontend (Vite env vars - injected at build time)
VITE_APP_PORT=4000
VITE_APP_API_URL=/api
VITE_APP_SELF_HOSTED=true
VITE_APP_WS_SERVER_URL=
VITE_APP_FIREBASE_CONFIG=
VITE_APP_BACKEND_V2_GET_URL=/api/scenes/shared/
VITE_APP_BACKEND_V2_POST_URL=/api/files
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=
VITE_APP_AI_BACKEND=
VITE_APP_ENABLE_PWA=false
VITE_APP_DISABLE_SENTRY=true
